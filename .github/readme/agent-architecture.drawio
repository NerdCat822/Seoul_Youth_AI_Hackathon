ngTop=10;fillColor=#F5F3FF;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="1480" y="140" width="260" height="135" as="geometry"/></mxCell><mxCell id="c35" value='&lt;b&gt;숫자 가드&lt;/b&gt;&lt;br&gt;&lt;span style="color:#64748B;font-size:12px"&gt;guard.py&lt;/span&gt;&lt;div style="font-size:11px;line-height:1.55"&gt;· 자료에 없는 숫자가 나오면&lt;/div&gt;&lt;div style="font-size:11px;line-height:1.55"&gt;· 그래프의 기본 문장으로 답함&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Pretendard;fontSize=13;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;spacing=8;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#FFFBEB;strokeColor=#D97706;" vertex="1" parent="1"><mxGeometry x="1480" y="310" width="260" height="105" as="geometry"/></mxCell><mxCell id="c36" value='&lt;b&gt;응답&lt;/b&gt;&lt;br&gt;&lt;span style="color:#64748B;font-size:12px"&gt;status · reply · draft · ideas&lt;/span&gt;&lt;div&gt;&lt;span style="color:#475569;font-size:11px"&gt;음성으로 물었으면 TTS로 읽어 줌&lt;/span&gt;&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Pretendard;fontSize=13;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;spacing=8;fillColor=#F1F5F9;strokeColor=#64748B;" vertex="1" parent="1"><mxGeometry x="1480" y="455" width="260" height="92" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Pretendard;fontSize=12;fontColor=#334155;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.27;entryX=0;entryY=0.5;" edge="1" parent="1" source="c2" target="c34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Pretendard;fontSize=12;fontColor=#334155;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c34" target="c35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Pretendard;fontSize=12;fontColor=#334155;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c35" target="c36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value='&lt;b&gt;대화 상태 · Postgres trylog_agent 스키마&lt;/b&gt;&lt;br&gt;&lt;span style="color:#64748B;font-size:12px"&gt;memory.py&lt;/span&gt;&lt;div style="font-size:12px;line-height:1.55"&gt;· PostgresSaver 체크포인트: 멈춘 단계와 초안 보존 → 서버를 다시 띄워도 이어짐&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.55"&gt;· conversations: 대화의 주인 가게 (다른 가게는 이어 쓸 수 없음)&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.55"&gt;· conversation_turns: 주고받은 말 (답 쓰기에 최근 3차례 사용)&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.55"&gt;· DB 설정이 없으면 서버 메모리 (개발 · 테스트)&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Pretendard;fontSize=13;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;spacing=8;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="250" y="705" width="560" height="150" as="geometry"/></mxCell><mxCell id="c41" value='&lt;b&gt;Spring API · trylog-api&lt;/b&gt;&lt;br&gt;&lt;span style="color:#64748B;font-size:12px"&gt;login.py · spring.py&lt;/span&gt;&lt;div style="font-size:12px;line-height:1.55"&gt;· 화면이 보낸 세션 쿠키와 X-CSRF-TOKEN을 그대로 넘김 → 로그인한 가게로 처리&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.55"&gt;· /overview · /menus: 오늘 날짜와 그 가게의 메뉴&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.55"&gt;· POST /experiments: 기록 저장 (Idempotency-Key로 중복 방지)&lt;/div&gt;&lt;div style="font-size:12px;line-height:1.55"&gt;· /experiments/{id}/report: 결과 설명에 쓸 숫자&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Pretendard;fontSize=13;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;spacing=8;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#ECFDF5;strokeColor=#059669;" vertex="1" parent="1"><mxGeometry x="860" y="705" width="570" height="150" as="geometry"/></mxCell><mxCell id="c42" value='&lt;b&gt;결과 설명 · explain_graph&lt;/b&gt;&lt;div style="font-size:11px;line-height:1.55"&gt;· collect_numbers: 보고서 숫자 모으기&lt;/div&gt;&lt;div style="font-size:11px;line-height:1.55"&gt;· write_explanation: Claude가 설명&lt;/div&gt;&lt;div style="font-size:11px;line-height:1.55"&gt;· check_numbers: 숫자 대조, 틀리면&lt;/div&gt;&lt;div style="font-size:11px;line-height:1.55"&gt;· 한 번 다시 → 그래도 틀리면 규칙 문장&lt;/div&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Pretendard;fontSize=13;fontColor=#0F172A;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;spacing=8;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fillColor=#F5F3FF;strokeColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="1480" y="705" width="260" height="150" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Pretendard;fontSize=12;fontColor=#334155;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c15" target="c41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="멈출 때마다 체크포인트 저장 · 이어갈 때 읽기" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;fontFamily=Pretendard;fontSize=12;fontColor=#334155;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;entryX=0.5;entryY=0;dashed=1;startArrow=block;startFill=1;" edge="1" parent="1" source="c2" target="c40"><mxGeometry relative="1" as="geometry"/></mxCell></root></m